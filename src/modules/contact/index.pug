section.contact-us.pad-8.overflow-hidden
	.container
		.row
			.col.w-full(class='lg:w-6/12')

				.txt(class='lg:pr-10')
					h2.heading-1.mb-4.text-grey-950 gửi lời nhắn
					.fmr-msg.mb-5.desc.body-2 Nếu Quý khách hàng có yêu cầu, thắc mắc. Vui lòng liên hệ với chúng tôi.
					.wrap-form.relative.z-50
						.wpcf7-form
							.form-group
								input(type='text' name='hoten' placeholder='Họ tên *' required)
							.form-group
								input(type='text' name='congty' placeholder='Tên công ty *' required)
							.form-group
								input(type='email' name='email' placeholder='Email *' required)
							.form-group
								input(type='tel' name='phone' placeholder='Số điện thoại *' required)
							.form-group.col-span-2
								textarea(name='noidung' placeholder='Nội dung')
							.frm-btnwrap.flex-start
							.btn-wrap.col-span-2(class='md:flex-between')
								.frm-captcha
								button.btn.btn-primary
									span.desc.body-1 Gửi
									em.fa-regular.fa-arrow-right
									
			.col.w-full(class='lg:w-5/12')
				.block-wrap(class='lg:pl-8')
					h2.heading-2.text-primary-1.mb-10  CÔNG TY CỔ PHẦN TẬP ĐOÀN DREAM LANDS 
					address
						ul
							li
								.icon
									em.fa-regular.fa-location-dot
								.desc.body-2
									p Văn phòng chính: Vinhomes Westpoint W1 Địa chỉ: 2Q6P+M93, Mễ Trì, Nam Từ Liêm, Hà Nội
							li
								.icon
									em.fa-regular.fa-phone
								.desc.body-2
									p info@duytan.com
							li
								.icon
									em.fa-regular.fa-envelope 
								.desc.body-2
									p +84 28 3876 2222 
