section.projects-detail-info(class='clamp:py-[40-80]')
	.container
		.row
			.col.w-full(class='lg:w-7/12')
				.content.flex.flex-col(class='clamp:gap-[24-24]')
					h2.heading-1.text-gray-950 Cụm Công Nghiệp Hồ Sơn 1
					.wrap.flex.flex-col(class='clamp:gap-[12-12]')
						div.desc.body-2.text-gray-950 Cụm Công nghiệp Hồ Sơn 1 sở hữu vị trí thuận lợi cho phát triển công nghiệp và thương mại, kết nối linh hoạt đến các trung tâm công nghiệp lớn và cửa khẩu quốc tế, đồng thời nằm trong khu vực giàu tiềm năng kinh tế của tỉnh Lạng Sơn.
						div.desc.body-2.text-gray-950 Sản phẩm chính: Cho thuê đất công nghiệp (50 năm) và cho thuê nhà xưởng xây sẵn
			.col.w-full(class='lg:w-5/12')
				.card
					.list.flex.flex-col(class='clamp:gap-[24-24]')
						.item.flex.flex-col(class='clamp:gap-[4-4]')
							div.desc.body-2.text-white.label.font-bold Vị trí
							div.desc.body-2.text-white Huyện Hữu Lũng, Tỉnh Lạng Sơn
						.item.flex.flex-col(class='clamp:gap-[4-4]')
							div.desc.body-2.text-white.label.font-bold Chủ đầu tư
							div.desc.body-2.text-white Công Ty Cổ Phần Đầu Tư Công Nghiệp Gia Định Miền Bắc
						.inner.flex.items-center(class='clamp:gap-[52-52]')
							.item.flex.flex-col(class='clamp:gap-[4-4]')
								div.desc.body-2.text-white.label.font-bold Quy mô
								div.desc.body-2.text-white 75 ha
							hr
							.item.flex.flex-col(class='clamp:gap-[4-4]')
								div.desc.body-2.text-white.label.font-bold Thời gian bàn giao
								div.desc.body-2.text-white 2025
