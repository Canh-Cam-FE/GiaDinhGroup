//- Local .png/.jpg/.jpeg get a sibling .webp <source> for free — export both
//- files with the same basename (e.g. hero.jpg + hero.webp) and this mixin
//- wires the <picture> automatically. Remote URLs, .svg, .gif, and .webp
//- passed directly are left as a plain <img> (see automation/agent-rules/08-media-swiper.md).
mixin FooImg(url="https://picsum.photos/1920/1080?nature=1", className="")
	- var className = className ? "lozad " + className : "lozad";
	- var isRemote = /^(?:https?:)?\/\//i.test(url);
	- var webpUrl = (!isRemote && /\.(png|jpe?g)(\?.*)?$/i.test(url)) ? url.replace(/\.(png|jpe?g)(\?.*)?$/i, ".webp$2") : null;
	if webpUrl
		picture
			source(type="image/webp" srcset=webpUrl)
			img(src=url, alt="", class=className, loading="lazy")
	else
		img(src=url, alt="", class=className, loading="lazy")
