//- Gold standard: Flexbox (.row / .col) + CSS Grid — zero redundant wrappers.
//- Apply layout utilities on .col / .list / semantic children — never empty .wrap or .inner for spacing alone.
section.example-page-grid(class='clamp:py-[48-96]')
	.container-xxl
		h3.heading-3.text-primary-2-title-content Flexbox columns (.row / .col)

		.row.items-start(class='gap-6 lg:gap-8')
			.col.w-full(class='lg:w-1/2')
				h4.heading-4.text-primary-2-title-content Column A
				div.desc.body-2 Copy sits directly on .col — no spacing-only .wrap or .inner.

			.col.w-full(class='lg:w-5/12')
				h4.heading-4.text-primary-2-title-content Column B
				div.desc.body-2 Use Tailwind V3 width fractions on .col (e.g. lg:w-5/12).

			.col.w-full(class='lg:w-7/12')
				.card.rounded-2.bg-grey-100.p-6
					div.desc.body-3 Named child (.card) only when it carries semantics — not as a generic spacer.

		h3.heading-3.text-primary-2-title-content(class='mt-12 lg:mt-16') CSS Grid (grid-template-columns)

		.list.grid.grid-cols-1.gap-6(class='md:grid-cols-2 lg:grid-cols-3')
			.item.rounded-2.bg-white.p-6.shadow-sm
				h4.heading-5.text-primary-2-title-content Grid item 1
				div.desc.body-4 Utilities on .list: grid + grid-cols-* — cells are direct children.

			.item.rounded-2.bg-white.p-6.shadow-sm
				h4.heading-5.text-primary-2-title-content Grid item 2
				div.desc.body-4 No extra wrapper between .list and .item.

			.item.rounded-2.bg-white.p-6.shadow-sm
				h4.heading-5.text-primary-2-title-content Grid item 3
				div.desc.body-4 Match column count to Figma (grid-cols-2, grid-cols-3, …).
