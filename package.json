{
	"name": "gulp-html",
	"description": "Gulp 4 pipeline: Pug, Sass, Tailwind CSS 3, esbuild app bundle",
	"main": "gulpfile.babel.js",
	"version": "3.2.3",
	"repository": "https://github.com/dreadfear/HTML-Mk.3",
	"private": false,
	"author": "dreadfear",
	"license": "MIT",
	"scripts": {
		"start": "gulp",
		"sync": "gulp sync",
		"prod": "gulp prod",
		"extract": "node automation/scripts/extract.mjs",
		"extract:pretty": "node automation/scripts/extract.mjs --pretty",
		"ir:build": "node automation/scripts/build-ir.mjs",
		"ir:check": "node automation/scripts/build-ir.mjs --check",
		"ir:resolve": "node automation/scripts/resolve.mjs",
		"ir:resolve:lenient": "node automation/scripts/resolve.mjs --lenient",
		"ir:resolve:check": "node automation/scripts/resolve.mjs --check",
		"emit:tailwind": "node automation/emit/tailwind-theme.mjs",
		"emit:tailwind:check": "node automation/emit/tailwind-theme.mjs --check",
		"emit:typography": "node automation/emit/typography.mjs",
		"emit:typography:check": "node automation/emit/typography.mjs --check",
		"emit:agent-lookup": "node automation/emit/agent-lookup.mjs",
		"emit:agent-lookup:check": "node automation/emit/agent-lookup.mjs --check",
		"tokens": "npm run ir:build && npm run ir:resolve && npm run emit:tailwind && npm run emit:typography && npm run emit:agent-lookup",
		"tokens:check": "npm run ir:check && npm run ir:resolve:check && npm run emit:tailwind:check && npm run emit:typography:check && npm run emit:agent-lookup:check",
		"agent": "node automation/scripts/agent-compiler.js",
		"audit:typography": "node automation/scripts/typography-audit.mjs",
		"audit:typography:page": "node automation/scripts/typography-audit.mjs --page",
		"audit:modules": "node automation/scripts/module-structure-audit.mjs",
		"audit:modules:page": "node automation/scripts/module-structure-audit.mjs --page",
		"audit:layout": "node automation/scripts/layout-geometry-audit.mjs",
		"audit:layout:page": "node automation/scripts/layout-geometry-audit.mjs --page",
		"scaffold:modules": "node automation/scripts/scaffold-modules.mjs",
		"scaffold:all": "node automation/scripts/scaffold-all-pages.mjs",
		"ci:tokens": "npm run tokens:check",
		"ci:typography": "npm run tokens:check && npm run prod && npm run audit:typography",
		"ci:modules": "npm run prod && npm run audit:modules",
		"ci:layout": "npm run prod && npm run audit:layout"
	},
	"babel": {
		"presets": [
			"@babel/preset-env"
		],
		"plugins": [
			"@babel/plugin-proposal-class-properties"
		]
	},
	"dependencies": {
		"@babel/core": "7.2.2",
		"@babel/plugin-proposal-class-properties": "^7.12.1",
		"@babel/preset-env": "7.3.1",
		"@babel/register": "7.18.9",
		"@material/web": "^2.4.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"autoprefixer": "^10.4.14",
		"browser-sync": "^2.27.10",
		"caniuse-lite": "^1.0.30001791",
		"css-declaration-sorter": "6.3.1",
		"cssnano": "5.1.12",
		"del": "6.0.0",
		"dotenv": "^16.4.5",
		"graceful-fs": "4.1.15",
		"gulp": "4.0.2",
		"gulp-concat": "2.6.1",
		"gulp-imagemin": "^7.1.0",
		"gulp-notify": "^4.0.0",
		"gulp-plumber": "1.2.1",
		"gulp-postcss": "^9.0.1",
		"gulp-pug": "^5.0.0",
		"gulp-sass": "6.0.1",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-terser": "^2.1.0",
		"plugin-error": "^2.0.1",
		"pug": "^3.0.2",
		"sass": "1.99.0",
		"vinyl-ftp": "^0.6.1"
	},
	"devDependencies": {
		"@fancyapps/ui": "^4.0.31",
		"esbuild": "^0.28.0",
		"gulp-esbuild": "^0.14.1",
		"gulp-rename": "^2.0.0",
		"inquirer": "^14.0.2",
		"tailwindcss": "3.4.17"
	}
}
